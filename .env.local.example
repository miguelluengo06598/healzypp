# ============================================================================
# Variables de entorno — copia este archivo como .env.local y rellena los valores
# NUNCA subas .env.local a git (ya está en .gitignore)
# ============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=ht

# Project Settings → API → anon / public key (segura para el cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ

# Project Settings → API → service_role / secret key (SOLO SERVIDOR — nunca NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJ

# ── Marca de la tienda (src/lib/site.ts) ────────────────────────────────────
# ÚNICA fuente de verdad del nombre/dominio/email mostrados en navbar, footer,
# metadata, páginas legales, notificaciones y Meta Pixel. Rellena estas 3 para
# personalizar tu marca sin tocar ningún archivo de código.

# Nombre de la tienda tal como se muestra al cliente. Opcional: si no se
# define, se usa "HEALZYP".
# NEXT_PUBLIC_SITE_NAME=Mi Tienda

# URL canónica del sitio. Opcional: si no se define, se usa https://healzyp.com
# (src/lib/site.ts). Útil en previews de Vercel o entornos de staging.
# NEXT_PUBLIC_SITE_URL=https://healzyp.com

# Email de contacto público — footer, email de confirmación de pedido, etc.
# Opcional: si no se define, se usa hola@healzyp.com. Distinto de los emails
# de las páginas legales (aviso-legal/terms/privacy), que son datos de tu
# empresa registrada y se rellenan a mano ahí, no por variable de entorno.
# NEXT_PUBLIC_CONTACT_EMAIL=hola@mitienda.com

# ── Mapbox — autocompletado de direcciones (España) ─────────────────────────
# Obtén tu token en: https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=pk..-hbA

# ── Stripe — pago con tarjeta ───────────────────────────────────────────────
# Obtén tus claves en: https://dashboard.stripe.com/apikeys
# Usa claves de TEST (pk_test_ / sk_test_) en desarrollo
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51

# Solo servidor — no añadir prefijo NEXT_PUBLIC_
STRIPE_SECRET_KEY=sk_test_51
# Webhook secret para verificar eventos de Stripe
# Obtén el secret en: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=wh

# ── Upstash Redis — Rate limiting distribuido ───────────────────────────────
# Crea una base de datos gratuita en: https://console.upstash.com/
# Requerido para que el rate limiting funcione correctamente en Vercel.
UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AZxx...

# NTFY - notificaciones de pedidos (opcional)
# Crea un topic gratuito en: https://ntfy.sh
NTFY_TOPIC=mi-tienda-orders

# ── Meta Pixel + Conversions API (CAPI) ─────────────────────────────────────
# Obtén tu Pixel ID en: https://business.facebook.com/events_manager
# NEXT_PUBLIC_ porque el script se carga en el navegador.
NEXT_PUBLIC_META_PIXEL_ID=1234567890123456

# Pixel ID server-side para CAPI (mismo valor que NEXT_PUBLIC_META_PIXEL_ID)
META_PIXEL_ID=1234567890123456

# Access Token para CAPI (server-side only)
# Crea un token en Events Manager → Configuración → Token de acceso de conversión
META_CAPI_ACCESS_TOKEN=EAxxxxxxxxxx

# Test Event Code de CAPI (opcional, solo para depurar eventos server-side en
# Events Manager → Probar eventos; no definir en producción)
# META_TEST_EVENT_CODE=TEST12345

# ── Pushover — notificaciones push al móvil ─────────────────────────────────
# Obtén tu User Key y crea una aplicación en: https://pushover.net/
# Solo servidor — no añadir prefijo NEXT_PUBLIC_
PUSHOVER_USER_KEY=uXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PUSHOVER_API_TOKEN=azXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Dashboard SaaS (healzyp-analytics u otro cliente del mismo API) ─────────
# Token único de esta instalación para GET /api/dashboard/stats y
# GET /api/dashboard/orders/[id] (Authorization: Bearer <token>). YA NO lo
# generas tú aquí: lo genera el dashboard SaaS al conectar esta tienda desde
# "Conectar tienda nueva" (POST /api/stores) y te lo enseña una vez — cópialo
# de ahí y pégalo tal cual. Las funciones que necesita este endpoint ya
# están incluidas en database/SETUP-COMPLETO.sql (sección 14) — si ya lo
# ejecutaste (ver GUIA-INSTALACION.md), no hace falta nada más aquí.
# Solo servidor — no añadir prefijo NEXT_PUBLIC_
DASHBOARD_API_TOKEN=

# Identifica esta instancia de despliegue para separar sus datos de tracking
# de otras instancias de la misma tienda que comparten esta misma Supabase
# (p.ej. tu localhost de desarrollo vs. la Vercel de producción). NO es un
# texto libre inventado a mano ("local-dev"/"produccion"): es el id (UUID)
# de la conexión de ESTA instancia en la tabla stores del dashboard SaaS —
# lo genera automáticamente al conectar la tienda con "Conectar tienda
# nueva" (junto a DASHBOARD_API_TOKEN, misma pantalla), único por conexión,
# sin riesgo de colisión entre tiendas ni de que alguien escriba algo
# inconsistente entre entornos. Si conectas la misma tienda dos veces
# (una por instancia), cada conexión te da su propio id — usa el que
# corresponda en cada .env. La columna store_instance_id y la función que
# la usan ya están incluidas en database/SETUP-COMPLETO.sql (secciones 9 y
# 14). Sin STORE_INSTANCE_ID en AMBOS entornos, las sesiones nuevas se
# guardan sin instancia asignada y no aparecen en ningún filtro.
# Solo servidor — no añadir prefijo NEXT_PUBLIC_
STORE_INSTANCE_ID=
